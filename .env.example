# Copiar a .env solo si ese archivo no existe. No subir .env.
# Copiar la URI exacta desde Connect en el proyecto Supabase compartido.
# Sustituir el marcador de contraseña localmente; codificar caracteres reservados.
DATABASE_URL=postgresql://postgres.gvsxekaqeodljocyqkfo:REEMPLAZAR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Modelo gratuito local; no se necesita OPENAI_API_KEY.
OLLAMA_MODEL=qwen3:4b-instruct

# Opcional: Groq sustituye a Ollama cuando hay clave. Nunca subir .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
